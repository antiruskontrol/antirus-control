{
    "manifest_version": 3,
    "name": "Проєкт Антірус: Текст+ютуб(+shorts) Контроль",
    "version": "2.0",
    "description": "Автоматично розмиває та блокує російськомовний текст на всіх вебсайтах, та перегортає сторінки з руснячим контентом",
    "permissions": [
        "activeTab",
        "storage"
    ],
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "action": {
        "default_icon": {
            "16": "icon.png",
            "48": "icon.png",
            "128": "icon.png"
        },
        "default_title": "Проєкт Антірус: Текст-Контроль"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "styles.css"
            ],
            "run_at": "document_end"
        }
    ]
}